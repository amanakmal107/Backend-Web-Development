# .env.example
#
# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore — never commit real secrets.
# .env.example IS committed so teammates know which variables are required.

# HTTP port the server listens on (default: 3000)
PORT=3000

# Runtime environment: development | test | production (default: development)
NODE_ENV=development

# Secret key used to sign JWTs — REQUIRED in production, no default
JWT_SECRET=your-secret-here

# Maximum number of articles allowed in the store (default: 50)
MAX_ARTICLES=50
