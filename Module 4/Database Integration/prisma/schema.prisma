generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(255)
  posts Post[]

  @@index([name])
}

model Post {
  id       Int    @id @default(autoincrement())
  title    String @db.VarChar(255)
  body     String @default("")
  authorId Int

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([title])
}
